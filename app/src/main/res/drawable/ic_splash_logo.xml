<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Glowing Radiant Gradient Background Base -->
    <path
        android:pathData="M30,10 H90 C101,10 110,19 110,30 V90 C110,101 101,110 90,110 H30 C19,110 10,101 10,90 V30 C10,19 19,10 30,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="110"
                android:endY="110"
                android:startX="10"
                android:startY="10"
                android:type="linear">
                <item android:color="#7D5260" android:offset="0.0" />
                <item android:color="#6750A4" android:offset="0.5" />
                <item android:color="#381E72" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Glassmorphism Reflection -->
    <path
        android:pathData="M30,10 H90 C101,10 110,19 110,30 V60 L50,110 H30 C19,110 10,101 10,90 V30 C10,19 19,10 30,10 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.12" />

    <!-- Pure White Futuristic CogniTask 'C' Outer Crescent Arc -->
    <path
        android:pathData="M80,38 A28,28 0 1,0 80,82"
        android:strokeWidth="11"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Radiant Gold Core Node Ball -->
    <path
        android:pathData="M60,60 A7,7 0 1,1 46,60 A7,7 0 1,1 60,60"
        android:fillColor="#FFD54F" />

    <!-- Futuristic Cyan Quantum Sparkle Star -->
    <path
        android:pathData="M78,38 L81,30 L84,38 L92,41 L84,44 L81,52 L78,44 L70,41 Z"
        android:fillColor="#80DEEA" />

</vector>
