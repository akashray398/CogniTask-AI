<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Executive Midnight Indigo to Royal Purple Gradient Base -->
    <path
        android:pathData="M30,10 H90 C101,10 110,19 110,30 V90 C110,101 101,110 90,110 H30 C19,110 10,101 10,90 V30 C10,19 19,10 30,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="110"
                android:endY="110"
                android:startX="10"
                android:startY="10"
                android:type="linear">
                <item android:color="#1E1B4B" android:offset="0.0" />
                <item android:color="#4338CA" android:offset="0.5" />
                <item android:color="#6366F1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Glassmorphism Reflection Overlay -->
    <path
        android:pathData="M30,10 H90 C101,10 110,19 110,30 V60 L50,110 H30 C19,110 10,101 10,90 V30 C10,19 19,10 30,10 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.12" />

    <!-- Big Pure White 'C' Crescent Arc (Cogni) -->
    <path
        android:pathData="M70,42 A20,20 0 1,0 70,82"
        android:strokeWidth="10.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Small Gold Superscript 'T' Bar & Stem (Task) -->
    <path
        android:pathData="M70,36 H88 M79,36 V52"
        android:strokeWidth="5"
        android:strokeColor="#FFD54F"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Accent Gold Node Dot -->
    <path
        android:pathData="M90,58 A4,4 0 1,1 82,58 A4,4 0 1,1 90,58"
        android:fillColor="#FFD54F" />

    <!-- Cyan Quantum Sparkle Star -->
    <path
        android:pathData="M88,27 L89.5,22.5 L91,27 L95.5,28.5 L91,30 L89.5,34.5 L88,30 L83.5,28.5 Z"
        android:fillColor="#80DEEA" />

</vector>
